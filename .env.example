APP_ENV=dev

# ── Pasta raiz de projetos (OBRIGATÓRIO) ──
# Path absoluto no host onde ficam os projetos. Montado como /projects no container.
# Default recomendado: $HOME/Documents/Projects
# macOS: /Users/<user>/Documents/Projects
# Linux: /home/<user>/Documents/Projects
# Windows (WSL): /mnt/c/Users/<user>/Documents/Projects
PROJECTS_HOST_ROOT=/Users/your-user/Documents/Projects

# ── API do assistente LLM ──
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ──
# UI e API saem da MESMA origem (:8000) — CORS só é necessário atrás de proxy
# ou quando outra origem consome a API diretamente.
# ALLOWED_ORIGINS=https://atlas.exemplo.com

# ── OpenSearch ──
OPENSEARCH_HOST=https://localhost:9200
OPENSEARCH_INDEX=atlasfile_documents
OPENSEARCH_USER=admin
# O install.sh gera uma senha única por instalação automaticamente.
# Instalação manual: defina uma senha forte (mín. 8 chars, com maiúscula,
# minúscula, número e símbolo — exigência do OpenSearch) nas DUAS variáveis.
OPENSEARCH_PASSWORD=Troque-Esta!Senha123
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Troque-Esta!Senha123
# Chave que encripta o cookie de sessão do Dashboards — ÚNICA por instalação
# (o install.sh e o make docker-up geram automaticamente). Com a chave default
# igual entre instâncias, cookie de instalação anterior causa 500; chave própria
# transforma cookie velho em redirect limpo de login. Mínimo 32 caracteres.
DASHBOARDS_COOKIE_PASSWORD=Troque-Esta-Senha-De-Cookie-Com-32-Ou-Mais-Chars

# Heap do OpenSearch (default 1g; 512m saturava o circuit breaker sob carga
# de indexação com vetores — incidente 2026-07-25). Ajuste se a máquina tiver
# pouca RAM: OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ── OpenSearch Dashboards (opcional, OPT-IN) ──
# O container de Dashboards não sobe por padrão (é ~1/3 do download de
# terceiros e o produto opera sem ele). Para ligar a observabilidade:
# DASHBOARDS_ENABLED=true          ← exibe o link na UI e ativa o auto-import
# COMPOSE_PROFILES=dashboards      ← faz o compose subir o container
# URL do Dashboards PARA O BROWSER (link "Observabilidade" no Painel), só para
# proxy/acesso remoto. Vazio = o backend deriva do host da request.
# DASHBOARDS_PUBLIC_URL=https://atlas.exemplo.com/dashboards

# ── Múltiplos checkouts na MESMA máquina (só desenvolvimento) ──
# Dois clones deste repo derivam o MESMO projeto compose ("atlasfile") →
# mesmos containers e MESMO volume do OpenSearch, com os dois .env disputando
# a senha do mesmo índice (um deles sempre quebra com 401 no boot). Se você
# mantém um segundo clone, dê a ele um namespace próprio:
# COMPOSE_PROJECT_NAME=atlasfile-dev
# (as portas continuam as mesmas — um stack no ar por vez)

# ── Versão da imagem (v1.0.0) ──
# Qual tag de ghcr.io/aleonnet/atlasfile este stack roda. SEM default de
# propósito: `latest` implícito faria duas instalações em datas diferentes
# divergirem. O instalador e o `make docker-up`/`docker-update` gravam
# automaticamente; o bundle de release já vem com o valor da tag.
# ATLASFILE_VERSION=1.0.0

# ── Reconciliação automática ──
PROJECTS_ROOT=/projects
CLASSIFIER_DATASETS_ROOT=/projects/_ATLASFILE/classifier/datasets
AUTO_RECONCILE_INTERVAL_SECONDS=600
AUTO_RECONCILE_REINDEX_SEARCH=true

# ── Auto-ingest (v0.50.0) ──
# A inbox processa sozinha: watcher de filesystem + sweep periódico; o widget
# global mostra o progresso. Desligue só para manutenção (volta o processamento
# por API/portal apenas). Parâmetros finos têm defaults medidos — ver
# backend/app/auto_ingest.py.
AUTO_INGEST_ENABLED=true

# ── Autenticação (API key + escopo de projeto) ──
# Default off (backward compat). Ligando, toda chamada exige Authorization: Bearer
# ou X-API-Key com uma key de config/api_keys.json (crie do api_keys.example.json;
# fica fora do git e é bind mount no container — trocar key NÃO exige rebuild).
# O /mcp (mesma porta 8000) valida a MESMA key. ATLASFILE_API_TOKEN é a
# credencial do app consigo mesmo (orchestrator→/mcp e tools→API) e precisa
# existir no json com projects ["*"].
# API_AUTH_ENABLED=false
# ATLASFILE_API_TOKEN=atlas_sk_troque-esta-chave-mcp

# ── Embeddings / busca semântica ──
# Habilita embeddings por chunk no índice atlasfile_chunk_vectors (RAG híbrido).
# Falha de embedding nunca quebra a ingestão — o doc é indexado sem vetores e flagado.
# EMBEDDING_ENABLED=true
# Provider: "openai" (text-embedding-3-small, requer OPENAI_API_KEY) ou
# "fastembed" (local/ONNX, requer: pip install -r backend/requirements-local-embeddings.txt)
# EMBEDDING_PROVIDER=openai
# Modelo/dimensão: vazio/0 = default do provider. Trocar exige recriar o índice de
# vetores e rodar backend/scripts/backfill_embeddings.py --force.
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSION=0
# EMBEDDING_BATCH_SIZE=100

# ── Canais de mensagem (opcional) ──
# Habilita o subsistema de canais (Telegram, Discord, Slack, etc.).
# CHANNELS_ENABLED=false
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=  # Obtenha via @BotFather no Telegram
# TELEGRAM_MIRROR_RESPONSES=false  # Espelhar respostas do web para o Telegram (default: off)
